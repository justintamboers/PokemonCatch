<Window x:Class="PokemonCatch.PokemonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PokemonCatch"
        mc:Ignorable="d"
        Title="PokemonWindow" Height="450" Width="800" Closed="Window_Closed">
    <Grid Background="Red">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.25*"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="0.25*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBox Name="TxtGok" Margin="20" TextChanged="TxtGok_SelectionChanged"></TextBox>

        <DataGrid Margin="20" Grid.Row="1" Name="DgdPokemon" SelectionChanged="DgdPokemon_SelectionChanged"></DataGrid>

        <ListBox Grid.Row="2" Name="LstPokemon">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Image Source="/whos_that_pokemon.png" Grid.RowSpan="3" Grid.Column="1" Margin="20" Name="ImgPokemon"></Image>
    </Grid>
</Window>
